{
  "name": "mycloset-functions",
  "description": "Server-side API relay for the MyCloset Android app",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test test/targets.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project rules-test 'node --test test/rules.test.js'"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "google-auth-library": "^9.14.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "typescript": "^5.6.3"
  }
}
